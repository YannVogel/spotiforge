{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spotiforge-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "send_metrics": false,
  "observability": {
    "enabled": true,
  },
  // Limite de forges par compte (src/limit/forge-limiter.ts) : un Durable Object par compte, stockage
  // SQLite (seul disponible sur l'offre gratuite).
  "durable_objects": {
    "bindings": [{ "name": "FORGE_LIMITER", "class_name": "ForgeLimiter" }],
  },
  "exports": {
    "ForgeLimiter": { "type": "durable-object", "storage": "sqlite" },
  },
  // Valeurs non secrètes, versionnées.
  "vars": {
    "CLAUDE_MODEL": "claude-opus-5-5",
  },
  // Secrets : `wrangler secret put` en production, `.dev.vars` en local (voir `.dev.vars.example`).
  "secrets": {
    "required": ["ANTHROPIC_API_KEY", "ALLOWED_SPOTIFY_IDS"],
  },
}
