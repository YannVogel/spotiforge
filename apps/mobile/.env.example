# Copier vers apps/mobile/.env (ignoré par git) puis remplacer les valeurs factices.
# Ces valeurs sont intégrées au bundle de l'app : n'y mettre aucun secret.

# Identifiant client de l'app Spotify (dashboard développeur Spotify). Public avec PKCE.
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=00000000000000000000000000000000

# URL du Worker de forge. En local depuis un téléphone : l'adresse IP de l'ordinateur sur le réseau.
EXPO_PUBLIC_WORKER_URL=http://192.168.1.10:8787
